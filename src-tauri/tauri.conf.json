{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost http://127.0.0.1:* http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "windows": [
      {
        "height": 800,
        "minHeight": 480,
        "minWidth": 360,
        "title": "Fable Files",
        "width": 1280
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build --prefix ./ui",
    "beforeDevCommand": "npm run dev --prefix ./ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": [
      "../themes",
      "resources/rom-dats.bin"
    ]
  },
  "identifier": "com.garrisonr.fablefiles",
  "productName": "Fable Files",
  "version": "0.1.0"
}